# syntax=docker/dockerfile:1
#
# Omni Analyst v2 - scheduler image.
#
# Runs the background sweep/fill loops (`python -m omni.scheduler`). It is a
# separate image from the API because the loops must keep running whether or not
# anyone is making requests, and request spikes on the API must not starve them.
#
# Run EXACTLY ONE scheduler per deployment. The fill workers lease gaps with
# SKIP LOCKED, so two schedulers would not corrupt the gap table - but the
# second one would double the data-provider API spend to produce the same
# coverage. See DEPLOY.md.
#
# The builder stage is identical to Dockerfile (API); keep them in sync when
# editing either. The only runtime difference is the CMD and the absence of an
# HTTP listener / healthcheck.

# --------------------------------------------------------------------------- #
# Stage 1 - builder (same as the API image).                                  #
# --------------------------------------------------------------------------- #
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

RUN uv venv /app/.venv

COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-annotate \
        | grep -vE '^[[:space:]]*-e[[:space:]]' \
        | grep -vE 'neutron-py' \
        > /tmp/requirements.txt \
 && uv pip install --python /app/.venv/bin/python -r /tmp/requirements.txt

ARG NEUTRON_WHEEL=vendor/neutron_py-0.1.0-py3-none-any.whl
COPY ${NEUTRON_WHEEL} /tmp/neutron.whl
RUN uv pip install --python /app/.venv/bin/python /tmp/neutron.whl

COPY src/        ./src/
COPY migrations/ ./migrations/

# --------------------------------------------------------------------------- #
# Stage 2 - runtime (no HTTP listener, so no EXPOSE / HEALTHCHECK).           #
# --------------------------------------------------------------------------- #
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    PATH=/app/.venv/bin:${PATH}

RUN useradd --create-home --uid 10001 --shell /sbin/nologin omni

WORKDIR /app

COPY --from=builder --chown=omni:omni /app/.venv      /app/.venv
COPY --from=builder --chown=omni:omni /app/src        /app/src
COPY --from=builder --chown=omni:omni /app/migrations /app/migrations

USER omni

# The scheduler's __main__ also runs the migrator on start. To avoid racing the
# API's migrator on a fresh database, compose starts this only after the API is
# healthy (i.e. migrations already applied); by then its own migrate() is a
# no-op. It logs sweep/gap/fill stats on shutdown.
CMD ["python", "-m", "omni.scheduler"]
