# Omni Analyst v2 edge: serves the built UI and reverse-proxies the API.
#
# Same-origin deploy. The UI is built with an empty API base (see ui/src/config.ts:
# production builds default to same-origin), so the browser calls relative paths
# and Caddy routes them by prefix. Set {$OMNI_ADDR} to serve HTTPS on a domain,
# or leave it unset for HTTP on port 80 (no public DNS -> no ACME).
#
#   OMNI_ADDR=omni.example.com   -> automatic HTTPS via Let's Encrypt
#   OMNI_ADDR=:80                -> HTTP on port 80, no TLS
#
# Build the UI before bringing this up:
#   npm --prefix ui run build
# Mount ui/dist at /srv/ui (see docker-compose.prod.yml).

{$OMNI_ADDR} {
	encode gzip zstd

	# Browser hardening. Safe headers that cannot break the SPA. A Content-
	# Security-Policy is deliberately omitted for now: the built asset graph
	# (vite modulepreload, any residual inline style) needs validating against a
	# real build before a script-src restriction lands, and a misconfigured CSP
	# takes the app down. HSTS is a no-op over plain HTTP (OMNI_ADDR=:80) and
	# activates automatically once TLS is on.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# Framework-provided + API routers. Listed explicitly so a static asset
	# path can never shadow a route. Add new top-level routers here.
	@api path /health /openapi.json /docs /redoc \
		/alerts /alerts/* /analysis /analysis/* /auth /auth/* \
		/autonomous /autonomous/* /briefing /briefing/* /bulletin /bulletin/* \
		/capabilities /capabilities/* /coverage /coverage/* \
		/entities /entities/* /exposure /exposure/* /gaps /gaps/* \
		/mcp /mcp/* \
		/objective/* /watchlists /watchlists/* \
		/portfolio /portfolio/* /research/* /scanner/* \
		/settings/* /system/* /trading /trading/* /wallets /wallets/*
	handle @api {
		reverse_proxy {$OMNI_API_UPSTREAM:-api:8000}
	}

	# Static UI assets (hashed files under /assets).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/ui
		try_files {path} =404
		file_server
	}

	# Everything else: serve the SPA, falling back to index.html for
	# client-side routing. The entry document is no-cache so a new deploy's
	# changed asset hashes reach the user immediately; the hashed /assets/*
	# above stay immutable (content-addressed). Without this, an edge cache
	# (Cloudflare) or the browser serves a stale index.html and the user's tab
	# keeps loading the old bundle -- new routes read as "not found".
	handle {
		root * /srv/ui
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
