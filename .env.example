DATABASE_URL=postgresql://postgres:postgres@localhost:5434/omni_v2
DEBUG=false

# Ingestion credentials. Every key is supplied by the operator of the
# deployment. See src/omni/credentials/catalog.py for the redistribution
# policy that governs whether data fetched with a given key may be shared.
FRED_API_KEY=
POLYGON_API_KEY=

# HS256 signing key for auth tokens. Set a strong (>=32 char) random string.
# Required: the server cannot issue or verify tokens without it.
OMNI_JWT_SECRET=
