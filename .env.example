DATABASE_URL=postgresql://postgres:postgres@localhost:5434/omni_v2
DEBUG=false

# Deployment profile. solo (default) sizes collection for a 2-4GB box: one
# year of price history, standing demand on the strongest sectors. full is the
# explicit opt-in: two years of depth, demand across all eleven sectors.
# Shallower history means noisier calibration and a quieter conviction gate --
# that refusal is correct behaviour, not breakage. See README.md.
OMNI_PROFILE=solo

# Ingestion credentials. Every key is supplied by the operator of the
# deployment. See src/omni/credentials/catalog.py for the redistribution
# policy that governs whether data fetched with a given key may be shared.
FRED_API_KEY=
POLYGON_API_KEY=

# HS256 signing key for auth tokens. Set a strong (>=32 char) random string.
# Required: the server cannot issue or verify tokens without it.
OMNI_JWT_SECRET=
